<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="340" viewBox="0 0 1200 340" role="img" aria-label="Cesar Jair Garcia Navarro - Full Stack Software Engineer">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#07111f"/><stop offset="56%" stop-color="#0b1d36"/><stop offset="100%" stop-color="#122d55"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#818cf8"/>
    </linearGradient>
    <radialGradient id="halo">
      <stop offset="0%" stop-color="#2563eb" stop-opacity="0.34"/><stop offset="100%" stop-color="#2563eb" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#93c5fd" stroke-width="0.6" opacity="0.11"/>
    </pattern>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="15" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>
  <rect width="1200" height="340" rx="17" fill="url(#bg)"/>
  <rect width="1200" height="340" rx="17" fill="url(#grid)"/>
  <ellipse cx="920" cy="65" rx="440" ry="280" fill="url(#halo)"/>
  <path d="M720 0 H1200 V340 H1070 C1050 225 940 133 720 0Z" fill="#1d4ed8" opacity="0.07"/>
  <path d="M0 0 H1200" stroke="url(#accent)" stroke-width="5"/>
  <path d="M0 335 H1200" stroke="url(#accent)" stroke-width="4" opacity="0.75"/>

  <rect x="48" y="38" width="38" height="38" rx="10" fill="#0d3156" stroke="#38bdf8" stroke-opacity="0.5"/>
  <text x="67" y="63" text-anchor="middle" fill="#e0f2fe" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="17">CG</text>
  <text x="102" y="61" fill="#9dd9f8" font-family="Arial, Helvetica, sans-serif" font-weight="700" letter-spacing="2.4" font-size="13">SOFTWARE ENGINEERING</text>
  <line x1="49" y1="102" x2="744" y2="102" stroke="#4f7ca8" opacity="0.36"/>

  <text x="46" y="177" fill="#ffffff" font-family="Arial, Helvetica, sans-serif" font-weight="800" letter-spacing="0.4" font-size="67">CESAR JAIR</text>
  <text x="46" y="239" fill="url(#accent)" font-family="Arial, Helvetica, sans-serif" font-weight="800" letter-spacing="-1.3" font-size="58">GARCÍA NAVARRO</text>
  <text x="49" y="280" fill="#d1e5f6" font-family="Arial, Helvetica, sans-serif" font-size="20">Full Stack Engineer  <tspan fill="#3b82f6">/</tspan>  API Builder  <tspan fill="#3b82f6">/</tspan>  Systems Thinker</text>
  <text x="49" y="313" fill="#80a4c2" font-family="Arial, Helvetica, sans-serif" font-size="13" letter-spacing="1.6">GUADALAJARA, MÉXICO  ·  DESIGN  →  BUILD  →  DEPLOY</text>

  <rect x="824" y="42" width="327" height="252" rx="15" fill="#071321" fill-opacity="0.95" stroke="#2b547c" stroke-width="1.5" filter="url(#shadow)"/>
  <rect x="824" y="42" width="327" height="42" rx="15" fill="#112841"/>
  <rect x="824" y="69" width="327" height="15" fill="#112841"/>
  <circle cx="845" cy="64" r="5.5" fill="#fb7185"/><circle cx="865" cy="64" r="5.5" fill="#fbbf24"/><circle cx="885" cy="64" r="5.5" fill="#34d399"/>
  <text x="986" y="69" text-anchor="middle" fill="#9ebbd4" font-family="monospace" font-size="12">~/engineering</text>
  <text x="845" y="115" fill="#38bdf8" font-family="monospace" font-size="14">$</text>
  <text x="862" y="115" fill="#dcebf8" font-family="monospace" font-size="14">whoami</text>
  <text x="846" y="140" fill="#ffffff" font-family="monospace" font-size="16" font-weight="700">full-stack engineer</text>
  <text x="846" y="169" fill="#38bdf8" font-family="monospace" font-size="14">$</text>
  <text x="863" y="169" fill="#dcebf8" font-family="monospace" font-size="14">focus --list</text>
  <text x="848" y="196" fill="#a4c7de" font-family="monospace" font-size="13">→ Enterprise applications</text>
  <text x="848" y="217" fill="#a4c7de" font-family="monospace" font-size="13">→ APIs &amp; integrations</text>
  <text x="848" y="238" fill="#a4c7de" font-family="monospace" font-size="13">→ Industrial software</text>
  <rect x="845" y="255" width="282" height="23" rx="6" fill="#0d2c2c" stroke="#245d55"/>
  <circle cx="858" cy="266.5" r="4" fill="#4ade80"/>
  <text x="871" y="271" fill="#86efac" font-family="monospace" font-size="11">AVAILABLE FOR OPPORTUNITIES</text>
</svg>